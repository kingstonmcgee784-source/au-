# Copy to backend/.env and adjust. Secrets live only here, never in the frontend.

ENVIRONMENT=development

# SQLite by default (created under backend/data/). Any SQLAlchemy URL works.
# DATABASE_URL=sqlite:///./data/alpha_research.db

# Apply database migrations automatically when the API starts.
AUTO_MIGRATE=true

# Browser origins allowed to call the API directly (comma-separated).
# The Next.js frontend proxies requests, so this matters only for direct access.
CORS_ORIGINS=http://localhost:3000

# Market data integration. Only "none" is supported until a provider is added.
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=

# AI research integration. Only "none" is supported until a provider is added.
AI_PROVIDER=none
AI_API_KEY=
